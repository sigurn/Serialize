<Project Sdk="Microsoft.NET.Sdk">

  <!-- Publishes with Native AOT and round-trips values through Sigurn.Serialize: no warnings and exit code 0 mean it works without reflection.
       dotnet publish src/Sigurn.Serialize.AotSmoke -c Release -r <rid> && <publish dir>/Sigurn.Serialize.AotSmoke -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishAot>true</PublishAot>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>NU1902;NU1903</WarningsNotAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Sigurn.Serialize/Sigurn.Serialize.csproj" />
    <ProjectReference Include="../Sigurn.Serialize.Generator/Sigurn.Serialize.Generator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
